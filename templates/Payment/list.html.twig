{% extends 'layout.html.twig' %}
{% if role == "ROLE_ADHERENT" %}
    {% set page_title = 'Paiements' %}    
{% else %}
    {% set page_title = 'Réception des paiements' %}
{% endif %}   


{% block body %}
    
{% include 'Payment/_page_switcher.html.twig' with {'curPage': 'global','role':role} %}
{% include 'Payment/_filters.html.twig' with {'filters': filters, 'years': years, 'farms':farms, 'adherents': adherents } %}
<div class="row paiement">
   <div class="col-md-12 text-center">
       
   {% include 'Partials/_pagination.html.twig' with {'pagination': pagination, 'role': role } %}
   </div>
   <div class="col-md-12">
        <table class="table table-bordered table-striped table-condensed">
            <thead>
                <tr>
                    <th>Dates</th>
                    {% if role == "ROLE_REFERENT" or role == "ROLE_FARMER" %}<th>Adhérent</th>{% endif %}
                    {% if role != "ROLE_FARMER" %}<th>Producteur</th>{% endif %}
                    <th>Type de paiement</th>
                    <th>Montant</th>
                    <th>Référence</th>
                    <th>Emis</th>
                    <th>Reçu</th>
                </tr>
            </thead>
            <tbody>
            {% for payment in payments %}
                <tr>
                    <td>{{ payment.periodStart|date("m/Y") }}</td>
                    {% if role == "ROLE_REFERENT" or role == "ROLE_FARMER" %}<td class="row-fkUser">{{ payment.adherent }}</td>{% endif %}
                    {% if role != "ROLE_FARMER" %}<td>{{ payment.farm }}</td>{% endif %}
                    <td>
                    {% if role == "ROLE_REFERENT" %}<a href="{{ path('payment_edit', {'id': payment.idPayment}) }}">{% endif %}
                        {{ payment.paymentType|paymentLabel }}
                    {% if role == "ROLE_REFERENT" %}</a>{% endif %}            

                    <td>
                        {% if role == "ROLE_REFERENT" %}<a data-toggle="tooltip" data-placement="bottom" title="Détails du paiement" href="{{ path('payment_edit', {'id': payment.idPayment}) }}">{% endif %}
                            {{ payment.amount|price_fr }}                        
                        {% if role == "ROLE_REFERENT" %}</a>{% endif %}     
                    </td>   
                    <td>{{payment.reference}}</td>  
                    <td>
                        {% if role == "ROLE_REFERENT" or role == "ROLE_ADHERENT" %}
                        <a id="issued-{{ payment.idPayment }}" data-toggle="tooltip" data-placement="bottom" title="Valider/invalider" 
                        class="btn btn-default" style="padding:0 12px;" href="#" 
                        onclick="changeIssuedAt({{payment.idPayment}});return false;">
                        {% endif %}
                            {% if payment.issuedAt %}
                                <i class="glyphicon glyphicon-ok text-success"></i>
                            {% else %}
                                <i class="glyphicon glyphicon-remove text-danger"></i>
                            {% endif %}
                        {% if role == "ROLE_REFERENT" or role == "ROLE_ADHERENT" %}                        
                        </a>
                        {% endif %}
                    </td>
                    <td>
                        {% if role == "ROLE_REFERENT" %}
                            <a id="received-{{ payment.idPayment }}" data-toggle="tooltip" data-placement="bottom" title="Valider/invalider" 
                                class="btn btn-default" style="padding:0 12px;" href="#" 
                                onclick="changeReceivedAt({{payment.idPayment}});return false;">
                        {% endif %}
                        {% if payment.receivedAt %}
                            <i class="glyphicon glyphicon-ok text-success"></i>
                        {% else %}
                            <i class="glyphicon glyphicon-remove text-danger"></i>
                        {% endif %}
                        {% if role == "ROLE_REFERENT"  %}
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
       </table>
       <div class="col-md-12 text-center">
            {% include 'Partials/_pagination.html.twig' with {'pagination': pagination, 'role': role } %}
        </div>
    </div>
</div>
{% include 'Payment/_modals.html.twig' %}
{% endblock %}
{% block footer_js %}
<script>
var root='{{ url('home') }}';
var role = '{{ role }}';

const changeIssuedAt = (idPayment) =>{
 const url = root+'ajax/checkIssued';
    $.ajax({
        url: url,
        type: 'POST',
        data: {
            'idPayment': idPayment
        },
        beforeSend: function () {    
            showSpinner();
        },
        success: function(data) {     
            let html = "";
            if (data == "1") {
                html = '<i class="glyphicon glyphicon-ok text-success"></i>';
            }     
            else {
                html = '<i class="glyphicon glyphicon-remove text-danger"></i>';
            }
            $('#issued-'+idPayment).html(html);            
            hideSpinner();      
        }
    });
}


const changeReceivedAt = (idPayment) =>{
 const url = root+'ajax/checkReceived';
    $.ajax({
        url: url,
        type: 'POST',
        data: {
            'idPayment': idPayment
        },
        beforeSend: function () {    
            showSpinner();
        },
        success: function(data) {   
            let html = "";
            if (data == "1") {
                html = '<i class="glyphicon glyphicon-ok text-success"></i>';
            }     
            else {
                html = '<i class="glyphicon glyphicon-remove text-danger"></i>';
            }
            $('#received-'+idPayment).html(html);              
            hideSpinner();      
        }
    });
}
</script>
<script type="text/javascript" src="{{ asset('js/payment.js') }}"></script>
{% endblock %}


