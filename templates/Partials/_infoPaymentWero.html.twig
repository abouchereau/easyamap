<div class="row">
    <div class="col col-md-7">
        <div class="row">
            <div class="col col-md-12">
                <p>Pour effectuer un virement WERO, merci de copier exactement les informations suivantes dans votre application bancaire.</p>
            </div>
        </div>

        <div class="row row-flex mt-4">
            <div class="col col-md-3 py-2 vertical-center">
                <b>Téléphone producteur</b>
            </div>
            <div class="col col-md-7 py-2">
                <input readonly type="text" id="wero-phone" value="" class="form-control" style="font-family: 'Roboto Mono'" onclick="this.select()"/>
            </div>
            <div class="col col-md-2 py-2">
                <a class="btn btn-info" onclick="toClipboard('wero-phone')">Copier</a>
            </div>
        </div>
        <div class="row row-flex mt-2">
            <div class="col col-md-3 py-2 vertical-center">
                <b>Référence</b>
            </div>
            <div class="col col-md-7 py-2">
                <input readonly type="text" id="wero-reference" value="" class="form-control" style="font-family: 'Roboto Mono'" onclick="this.select()" />
                <input type="hidden" id="wero-id-payment" value="{{ payment.idPayment }}" />
            </div>
            <div class="col col-md-2 py-2">
                <a class="btn btn-info" onclick="toClipboard('wero-reference')">Copier</a>
            </div>
        </div>
        <div class="row row-flex mt-2">
            <div class="col col-md-3 py-2 vertical-center">
                <b>Montant (€)</b>
            </div>
            <div class="col col-md-7 py-2">
                <input readonly type="text" id="wero-montant" value="" class="form-control" style="font-family: 'Roboto Mono'" onclick="this.select()"/>
            </div>
            <div class="col col-md-2 py-2">
                <a class="btn btn-info" onclick="toClipboard('wero-montant')">Copier</a>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', ()=>{
        $.ajax({
            url: root+"ajax/getInfoVirement/{{ payment.idPayment }}/{{ constant('App\\Entity\\PaymentType::WERO') }}",
            dataType: 'json',
            beforeSend: function () {
                 $("#loader").show();
            },
            success: function(data) {                
                $("#loader").hide();                
                $("#wero").modal("show");     
                $("#wero-phone").val(data.phone);
                $("#wero-montant").val(data.montant);
                $("#wero-reference").val(data.reference);
            }
        });       
    }
, false);
</script>